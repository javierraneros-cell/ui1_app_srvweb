<!DOCTYPE html>
<html lang="es" id="<%= pageId || '' %>">

<!-- ===========================
          HEAD
=========================== -->
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= titulo %></title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
          rel="stylesheet"
          integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
          crossorigin="anonymous">

    <!-- Tus estilos -->
    <link href="/css/estilos.css" rel="stylesheet" type="text/css">

    <!-- Google Icons -->
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined&display=swap">

    <!-- Metadatos -->
    <meta name="author" content="GRUPO 4 Javier Raneros Cartujo" >
    <meta name=description content="Página de inicio de proyecto plataforma de cursos en línea de Formación Global Online COLABORATIVO" >
    <meta name="keywords" content="cursos, formación, profesores, datos abiertos, virtualización, colaborativo" >
</head>

<!-- ===========================
          BODY
=========================== -->
<body>

    <!-- HEADER (con carrusel incluido) -->
    <!-- Introducimos el carusel con la clase de Bootstrap -->
    <% if (header === "index") { %>
        <%- include("partials/header-index") %>
    <% } else { %>
        <%- include("partials/header-simple") %>
    <% } %>

    <!-- CONTENIDO MAIN -->
    <main id="contenedor-main">
        <%- body %>
    </main>

    <!-- FOOTER -->
    <%- include("partials/footer") %>

    <!-- ===========================
              SCRIPTS
    =========================== -->

    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Scripts globales -->
    <script src="/js/menu.js"></script>
    <script src="/js/footer.js"></script>

    <!-- Scripts específicos opcionales -->
    <%- typeof scripts !== "undefined" ? scripts : "" %>

</body>
</html>
