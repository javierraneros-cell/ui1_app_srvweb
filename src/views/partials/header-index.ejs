<header>
    <h1 class="visually-hidden">Formación Global Online</h1>

    <div>
        <img class="img-fluid" src="/imagenes/bannerFormacionGlobalOnline.png" alt="Formación Global Online banner">
    </div>

    <!-- Carrusel SOLO para index -->
    <div id="carruselIndex" class="carousel slide" data-bs-ride="carousel">
        <div class="carousel-inner">

            <div class="carousel-item active blanco">
                <img src="/imagenes/formacion1.jpg" class="d-block w-100" alt="">
                <div class="carousel-caption d-none d-md-block">
                    <h1>CURSO ELABORACIÓN DE INFORMES ACCESIBILIDAD SITIOS WEB</h1>
                </div>
            </div>

            <div class="carousel-item rojo">
                <img src="/imagenes/formacion2.jpg" class="d-block w-100" alt="">
                <div class="carousel-caption d-none d-md-block">
                    <h1>CURSO DATOS ABIERTOS Y REUTILIZACIÓN DE LA INFORMACIÓN</h1>
                </div>
            </div>

            <div class="carousel-item blanco">
                <img src="/imagenes/formacion3.jpg" class="d-block w-100" alt="">
                <div class="carousel-caption d-none d-md-block">
                    <h1>CURSO VIRTUALIZACIÓN DE SISTEMAS Y CENTROS DE DATOS</h1>
                </div>
            </div>

        </div>

        <button class="carousel-control-prev" type="button" data-bs-target="#carruselIndex" data-bs-slide="prev">
            <span class="material-symbols-outlined">skip_previous</span>
        </button>

        <button class="carousel-control-next" type="button" data-bs-target="#carruselIndex" data-bs-slide="next">
            <span class="material-symbols-outlined">skip_next</span>
        </button>
    </div>

    <!-- MENU -->
    <div id="contenedor-menu"><%- include("menu") %></div>

    <!-- Usuario conectado -->
    <div id="contenedor-header-usuario">
        <span id="header-nombre"></span>
        <span id="header-logout"></span>
    </div>
</header>
