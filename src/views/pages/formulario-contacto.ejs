<!-- MAIN -->
<main id="contenedor-main">
    <h2><span class="material-symbols-outlined">contact_mail</span> Formulario de Contacto</h2>
    <div id="contenedor-respuesta-formulario" class="d-none" role="alert"></div>
    <div id="contenedor-formulario" class="mb-4" >
        <!-- Usamos la clase row de Bootstrap para crear filas y col-sm-x para crear columnas segun necesitemos los anchos -->
        <form id="form-contacto" >
            <div class="row mb-2" >
                <div class="form-floating col-sm-8" >
                    <input type="text" id="nombre" class="form-control" placeholder="Introduce tu nombre...">
                    <label for="nombre" >Nombre</label>
                    <div class="invalid-feedback">
                        Porfavor, introduce un nombre válido.
                    </div>
                </div>
                
                <div class="form-floating col-sm-4" >
                    <input type="email" id="correo" class="form-control" placeholder="Introduce tu correo...">
                    <label for="correo" >Correo</label>
                    <div class="invalid-feedback">
                        Porfavor, introduce un correo válido tipo nombre@ejemplo.com
                    </div>
                </div>
            </div>
            <div class="row mb-3" >
                <div class="form-floating col-sm-12">
                    <select id="tematica" class="form-select" aria-label="Seleccione temática">
                        <option value="">Seleccione temática...</option>
                        <option value="Tecnología">Tecnología</option>
                        <option value="Cívicas y Sociales">Cívicas y Sociales</option>
                    </select>
                    <label for="tematica" >Tematica</label>
                    <div class="invalid-feedback">
                        Porfavor, selecciona una temática válida
                    </div>
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-sm-12">
                    <textarea id="mensaje" class="form-control mb-2 " rows="5" placeholder="Escribe tu mensaje aquí..."></textarea>
                    <div id="contenedor-conteo-mensaje" class="alert-warning" role="alert">
                        <p>Número de caracteres en mensaje:     <span id="conteo-mensaje"></span></p>
                    </div>
                    <div class="invalid-feedback">
                        Porfavor, introduce un mensaje de al menos 30 caracteres
                    </div>
                </div>
            </div>

            <!-- Enviar -->
            <button type="submit" class="btn btn-outline-primary w-100 mt-3" >Enviar</button>
        </form>
    </div>
</main>