<main id="contenedor-main">
    <h2><span class="material-symbols-outlined">login</span> Login</h2>
    <div id="sesion-feedback" class="d-none mb-3" role="alert"></div>

    <section class="card mb-4" id="bloque-auth-admin">
        <h3>Acceder</h3>
        <form id="form-login-admin" class="row g-3">
            <div class="col-12 col-md-5">
                <label for="admin-email" class="form-label">Email</label>
                <input id="admin-email" type="email" class="form-control" required>
            </div>
            <div class="col-12 col-md-5">
                <label for="admin-password" class="form-label">Password</label>
                <input id="admin-password" type="password" class="form-control" required>
            </div>
            <div class="col-12 col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-outline-primary w-100">Acceder</button>
            </div>
        </form>
    </section>

</main>